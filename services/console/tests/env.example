# Settings for the test suite. Copy to tests/.env (ignored by git), fill in the empty values from the
# stack under test, and run `pixi run test <docker network of that stack>`.
# The addresses below are the ones a local stack usually has; change them to match yours.

# Public addresses, as a browser uses them. They must resolve inside the stack's network too.
CONSOLE_URL=http://console.localhost:8000
GATEWAY_URL=http://gateway.localhost:8000
LITELLM_ADMIN_URL=http://litellm.localhost:8000
KEYCLOAK_URL=http://auth.localhost:8000

# Internal addresses.
BROKER_URL=http://console-broker:8100
LITELLM_URL=http://litellm:4000
MAILPIT_URL=http://mailpit:8025
MLFLOW_URL=http://mlflow:5050
KNOWLEDGE_HUB_URL=http://okf.localhost:7878

# The same values the console services run with.
OIDC_CLIENT_ID=console
OIDC_CLIENT_SECRET=
CONSOLE_BROKER_CALLER_SECRET=
LITELLM_MASTER_KEY=

# console_db as the Postgres superuser and as the console's two roles:
# postgresql://<user>:<password>@postgres:5432/console_db
SUPERUSER_DATABASE_URL=
BROKER_DATABASE_URL=
WEB_DATABASE_URL=

# The blob storage LiteLLM writes its request logs to (container `litellm-logs`).
AZURE_STORAGE_CONNECTION_STRING=
