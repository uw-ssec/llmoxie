// For format details, see https://aka.ms/devcontainer.json. For config options, see the
{
  "build": {
    "dockerfile": "./Dockerfile",
    "context": ".."
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-toolsai.jupyter",
        "ms-python.python",
        "ms-azuretools.vscode-docker"
      ]
    },
    "codespaces": {
      "openFiles": ["README.md"]
    }
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },
  "onCreateCommand": {
    "pixi-install": "pixi install -e llmaven"
  },
  "postCreateCommand": {
    "create-shell-hook": "pixi shell-hook --shell bash > /etc/profile.d/pixi.sh"
  },
  "runArgs": [
    "--privileged", // Allow privileged mode for Docker
    "--volume=/var/run/docker.sock:/var/run/docker.sock", // Bind Docker socket for host communication
    "--gpus=all"
  ],
  "securityOpt": [
    "seccomp=unconfined" // Relax security for Docker operations
  ],
  "forwardPorts": [4000, 8080]
}
